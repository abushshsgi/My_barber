# Mysaloon Expo (apps/mobile) — nusxa: cp .env.example .env
#
# Muhim: Vertex / Gemini / DB / wallet secretlari FAQAT backendda.
# Mobil ilova AI ni `EXPO_PUBLIC_API_URL` orqali chaqiradi.

# Backend API (production)
EXPO_PUBLIC_API_URL=https://api.mysaloon.uz

# Google Maps — Android/iOS native MapView + web JS
# Cloud Console: Maps SDK for Android, Maps SDK for iOS, Maps JavaScript API,
# Geocoding API, Places API (Text Search) yoqing.
# Android restriction: package uz.mysaloon.app + SHA-1 (EAS credentials).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Sign-In — FAQAT Web OAuth client ID (client_type 3).
# Android client ID (...tkfiilj...) ishlatilmasin — 400 invalid_request beradi.
# google-services.json dagi web: ...jtjdkj187hmn98r3snfqfuiqnd3ctjui...
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
