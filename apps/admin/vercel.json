{
  "ignoreCommand": "node ../../scripts/vercel-ignore-build.mjs admin",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://api.mysaloon.uz/api/v1/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://api.mysaloon.uz/media/:path*"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.ico"
    },
    {
      "source": "/(.*\\..*)",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

