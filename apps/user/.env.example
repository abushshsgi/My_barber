# Production (Vercel): Railway HTTPS manzili, oxirida / bo‘lmasin — /media proksi uchun majburiy
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Token aralashmasligi uchun (bir brauzerda user+barber ochilganda):
NEXT_PUBLIC_AUTH_KIND=user

# Sartarosh ilovasi alohida domen bo‘lsa (masalan https://barber.myapp.uz), yo‘q bo‘lsa nisbiy /barber ishlatiladi
# NEXT_PUBLIC_BARBER_WEB_ORIGIN=https://barber.myapp.uz
# Lokal: npm run dev:barber → :3002
# NEXT_PUBLIC_BARBER_WEB_ORIGIN=http://localhost:3002
