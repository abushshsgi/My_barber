# Users app — environment variables
# Production / preview:
VITE_API_URL=https://api.mysaloon.uz
# Local dev: odatda VITE_API_URL ni o'chiring — server.ts /api/v1 ni api.mysaloon.uz ga proxy qiladi.
# Alternate name (optional):
# NEXT_PUBLIC_API_URL=https://api.mysaloon.uz

# Backend CORS (Railway / production): set on API server, not in this app:
# FRONTEND_USER_ORIGIN=https://www.mysaloon.uz,https://mysaloon.uz
