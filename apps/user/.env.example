# Users app — environment variables

# Production web (Vercel): VITE_API_URL ni o'chiring — /api/v1 same-origin proxy orqali ishlaydi.
# Native mobil: apps/mobile (Expo) — o'z env/config.
# Google Maps JS (client-side map tiles — restrict HTTP referrers in Cloud Console):
VITE_GOOGLE_MAPS_API_KEY=
# Alternate names (optional):
# NEXT_PUBLIC_API_URL=https://api.mysaloon.uz

# Local dev: odatda VITE_API_URL ni o'chiring — vite proxy /api/v1 ni 127.0.0.1:8000 ga yo'naltiradi.
# DEV_API_TARGET=http://127.0.0.1:8000

# Partner web (footer, for-salons, chat deep link):
# VITE_BARBER_WEB_ORIGIN=https://partner.mysaloon.uz
# NEXT_PUBLIC_BARBER_WEB_ORIGIN=https://partner.mysaloon.uz

# Auth kind (Vercel legacy — optional):
# NEXT_PUBLIC_AUTH_KIND=user

# Google Analytics 4 (mysaloon.uz web stream). Optional — default G-38QNBFBNZG in production.
# VITE_GA_MEASUREMENT_ID=G-38QNBFBNZG

# Google Sign-In (mijoz login — asosiy)
# Google Cloud Console → OAuth 2.0 Web client
# Authorized JavaScript origins: https://www.mysaloon.uz, https://mysaloon.uz, http://localhost:3000
VITE_GOOGLE_CLIENT_ID=
# SMS/telefon login (Eskiz ulanganda yoqing):
# VITE_PHONE_AUTH_ENABLED=true

# Backend CORS (Railway / production): API serverda sozlanadi, bu ilovada emas:
# FRONTEND_USER_ORIGIN=https://www.mysaloon.uz,https://mysaloon.uz
