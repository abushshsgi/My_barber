# Users app — environment variables

# Production web (Vercel): VITE_API_URL ni o'chiring — /api/v1 same-origin proxy orqali ishlaydi.
# Capacitor / mobil build:
# VITE_API_URL=https://api.mysaloon.uz
# 2GIS MapGL (client-side map tiles — restrict domains in 2GIS Console):
VITE_DGIS_API_KEY=
# Alternate names (optional):
# NEXT_PUBLIC_API_URL=https://api.mysaloon.uz

# Local dev: odatda VITE_API_URL ni o'chiring — vite proxy /api/v1 ni 127.0.0.1:8000 ga yo'naltiradi.
# DEV_API_TARGET=http://127.0.0.1:8000

# Partner web (chat deep link, salon staff links):
# NEXT_PUBLIC_BARBER_WEB_ORIGIN=https://partner.mysaloon.uz

# Auth kind (Vercel legacy — optional):
# NEXT_PUBLIC_AUTH_KIND=user

# Backend CORS (Railway / production): API serverda sozlanadi, bu ilovada emas:
# FRONTEND_USER_ORIGIN=https://www.mysaloon.uz,https://mysaloon.uz
