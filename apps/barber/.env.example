# Lokal development — VITE_API_URL bo'sh qoldiring (Vite /api/v1 proxy).
# DEV_API_TARGET=http://127.0.0.1:8000

# Production (.env.production): VITE_API_URL=https://api.mysaloon.uz

# Mijoz ilovasi havolasi (auth cross-link)
# VITE_USER_WEB_ORIGIN=http://localhost:3000
# Production default: https://mysaloon.uz

# 2GIS MapGL (xarita — mijoz ilovasidagi kalit bilan bir xil, 2GIS Console da partner domenini qo'shing):
# VITE_DGIS_API_KEY=your-mapgl-key
# Geocoder (shahar/ko'cha avtoto'ldirish) backend DGIS_API_KEY orqali /api/v1/geo/* da ishlaydi.
