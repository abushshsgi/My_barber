# Lokal development — VITE_API_URL bo'sh qoldiring (Vite /api/v1 proxy).
# DEV_API_TARGET=http://127.0.0.1:8000

# Production web (Vercel partner.mysaloon.uz): VITE_API_URL ni O'CHIRING — same-origin proxy.
# Yoki to'g'ridan-to'g'ri: VITE_API_URL=https://api.mysaloon.uz

# Mijoz ilovasi havolasi (auth cross-link)
# VITE_USER_WEB_ORIGIN=http://localhost:3000
# Production default: https://mysaloon.uz

# Google Maps JS (xarita — mijoz ilovasidagi kalit bilan bir xil; Cloud Console da partner domenini qo'shing):
# VITE_GOOGLE_MAPS_API_KEY=your-maps-key
# Geocoder (shahar/ko'cha avtoto'ldirish) backend GOOGLE_MAPS_API_KEY orqali /api/v1/geo/* da ishlaydi.
