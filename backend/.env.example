# =============================================================================
# MyBarber backend — nusxa:  cp .env.example .env
# =============================================================================
#   pip install -r requirements.txt
#   python manage.py migrate
#   python manage.py runserver
#
# Admin: python manage.py create_admin_account you@example.com
# =============================================================================

# --- Ma’lumotlar bazasi ---
# Comment / o‘chirish → SQLite: backend/db.sqlite3
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app

# --- WebSocket (Channels) ---
# Lokal: bo‘sh — InMemory. Production: Redis
REDIS_URL=

# --- CORS / frontend (oxirida / yo‘q) ---
# FRONTEND_USER_ORIGIN=http://localhost:3000
# FRONTEND_ADMIN_ORIGIN=http://localhost:3001
# FRONTEND_BARBER_ORIGIN=http://localhost:5173
# Barber email tasdiq havolasi — FRONTEND_BARBER_ORIGIN ning birinchi URL
# FRONTEND_BARBER_ORIGIN=https://barber.myapp.uz
# CORS_ALLOWED_ORIGINS=https://preview-xxx.vercel.app

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@mybarber.local

# --- Eslatmalar (cron) ---
# python manage.py remind_bookings
