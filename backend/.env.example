# =============================================================================
# MyBarber backend — nusxa:  cp .env.example .env
# =============================================================================
#   pip install -r requirements.txt
#   python manage.py migrate
#   python manage.py runserver
#
# Admin: python manage.py create_admin_account you@example.com
# =============================================================================

# --- Ma’lumotlar bazasi ---
# Comment / o‘chirish → SQLite: backend/db.sqlite3
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app
# Production (mysaloon.uz): ikkalasidan biri yetarli
# DJANGO_ALLOWED_HOSTS=api.mysaloon.uz,.railway.app
# API_PUBLIC_HOST=api.mysaloon.uz

# --- Hamyon ---
# Production'da alohida uzun random string (SECRET_KEY dan farqli bo'lsin).
# WALLET_HMAC_SECRET=

# --- WebSocket (Channels) + OTP cache ---
# Lokal: bo'sh — InMemory. Production: Redis (Channels + CACHES ikkalasi uchun)
REDIS_URL=

# --- Pixabay (salon fallback cover sync skripti — frontendda emas) ---
# https://pixabay.com/api/docs/
# PIXABAY_API_KEY=
# node scripts/sync-pixabay-covers.mjs

# --- Pexels (mock salon seed — backend) ---
# https://www.pexels.com/api/documentation/
# PEXELS_API_KEY=   (faqat --upload-images --pexels-api uchun)
# Tez deploy (tavsiya):
#   python manage.py seed_tashkent_mock_salons
# Rasmlar API orqali Pexels CDN qaytadi — fayl yuklash shart emas.
# Sekin (storage ga fayl):
#   python manage.py seed_tashkent_mock_salons --upload-images

# --- CORS / frontend (oxirida / yo‘q) ---
# FRONTEND_USER_ORIGIN=http://localhost:3000
# FRONTEND_ADMIN_ORIGIN=http://localhost:3001
# FRONTEND_BARBER_ORIGIN=http://localhost:5173
# Production (mysaloon.uz + Vercel):
# FRONTEND_USER_ORIGIN=https://www.mysaloon.uz,https://mysaloon.uz
# FRONTEND_ADMIN_ORIGIN=https://admin.mysaloon.uz
# FRONTEND_BARBER_ORIGIN=https://partner.mysaloon.uz
# (email tasdiq havolasi: https://partner.mysaloon.uz/verify-email?token=...)
# Muhim: production FRONTEND_BARBER_ORIGIN da localhost bo‘lmasin (yoki lokal URL ro‘yxat oxirida).
# Barber email localhostni o‘tkazib yuboradi va https://partner.mysaloon.uz ishlatadi.
# Mobil ilova deep link scheme (default: mysaloonpartner)
# BARBER_MOBILE_VERIFY_SCHEME=mysaloonpartner
# CORS_ALLOW_HEADERS (x-session-id) — backend/config/settings.py da default_headers bilan berilgan.
# CORS_ALLOWED_ORIGINS=https://preview-xxx.vercel.app
#
# --- Production Railway checklist (web + Expo) ---
# Tayyor fayl: backend/.env.production (gitignore — Railway Variables ga nusxa)
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=api.mysaloon.uz,.railway.app
# API_PUBLIC_HOST=api.mysaloon.uz
# API_PUBLIC_BASE_URL=https://api.mysaloon.uz
# FRONTEND_USER_ORIGIN=https://www.mysaloon.uz,https://mysaloon.uz
# FRONTEND_ADMIN_ORIGIN=https://admin.mysaloon.uz
# FRONTEND_BARBER_ORIGIN=https://partner.mysaloon.uz
# REDIS_URL=redis://...   (WebSocket/chat uchun majburiy)
# VERTEX_SERVICE_ACCOUNT_JSON={"type":"service_account",...}  (bitta qator JSON)
# GOOGLE_APPLICATION_CREDENTIALS faqat lokal — Railway da ishlatilmaydi

# --- SMS / Telegram OTP (mijoz login) ---
# Hozir bo‘sh — kod ilovada ko‘rinadi (delivery=app). Keyin provayder ulang:
#
# SMS (Eskiz):
# SMS_PROVIDER=eskiz
# ESKIZ_EMAIL=
# ESKIZ_PASSWORD=
#
# Telegram Gateway (gateway.telegram.org — kod Telegram «Verification Codes» chatiga):
# SMS_PROVIDER=telegram
# TELEGRAM_GATEWAY_TOKEN=
# Ixtiyoriy: tekshiruvdan o‘tgan kanal (@username, @ siz):
# TELEGRAM_GATEWAY_SENDER_USERNAME=

# --- Google Sign-In (mijoz web / mobil) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Authorized JavaScript origins: https://www.mysaloon.uz, https://mysaloon.uz, http://localhost:3000
# GOOGLE_OAUTH_CLIENT_ID=123456789.apps.googleusercontent.com
# Bir nechta client (web + android): vergul bilan

# --- Email ---
# VARIANT A (Railway / bulut — tavsiya): Resend HTTPS (443); SMTP uchun TCP ko‘pincha timeout.
# Qo‘shyotganda SETTINGS avtomatik Resend EMAIL_BACKEND ga o‘tadi.
RESEND_API_KEY=
#
# VARIANT B — to‘g‘ridan-to‘g‘ri SMTP (aHost va h.k., odatda o‘zingizning VPS):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# aHost — Outgoing: de.ahost.cloud port 465 SSL
#
# --- Email SMTP (faqat VARIANT B; VARIANT A da ham DEFAULT_FROM_EMAIL / BARBER_FROM_EMAIL kerak) ---
# RESEND yo‘qligicha lokal uchun console mumkin:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# aHost cPanel — Outgoing (SMTP): de.ahost.cloud, port 465, SSL
EMAIL_HOST=de.ahost.cloud
EMAIL_PORT=465
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true
EMAIL_HOST_USER=verify@mysaloon.uz
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@mysaloon.uz
BARBER_FROM_EMAIL=MySaloon <verify@mysaloon.uz>

# --- AI Stil (MySaloon) ---
# Rasm generatsiya (try-on / explore): Vertex asosiy (GCP kvota).
# GEMINI_API_KEY ixtiyoriy zaxira — Vertex sozlangan bo'lsa o'chirib qo'yish mumkin.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Morf AI ovoz (TTS). STT gemini-2.5-flash orqali.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Zaxira: AI Studio (Vertex yo'q yoki 429/5xx bo'lsa)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
VERTEX_IMAGE_MODEL=gemini-3.1-flash-lite-image
# Morf Studio tahrir — eng arzon flash-lite (~$0.03 / tahrir).
# gemini-3.1-flash-lite-image | gemini-3.1-flash-image | gemini-3-pro-image (qimmat)
STUDIO_EDIT_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Try-on Redis navbat (REDIS_URL bo'lsa avtomatik; worker bin/start.sh da ishga tushadi)
# TRYON_QUEUE_ENABLED=true
# TRYON_QUEUE_MAX_DEPTH=200
# TRYON_JOB_TTL_SECONDS=3600

# Asosiy: Vertex service account (Vertex AI User + billing)
# VERTEX_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
VERTEX_IMAGE_LOCATION=global

# --- User Capacitor FCM push ---
# Firebase Console → Project settings → Service accounts → Generate new private key
# Yoki legacy: Cloud Messaging → Server key
# FCM_SERVER_KEY=AAAA...
# FCM_PROJECT_ID=my-firebase-project
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# (FIREBASE bo'sh bo'lsa VERTEX_SERVICE_ACCOUNT_JSON fallback — bir xil GCP loyiha)

# Explore rasm generatsiya (production: DEBUG=false + secret)
# Sahifa: https://www.mysaloon.uz/dev/explore-gen?key=YOUR_SECRET
EXPLORE_GEN_SECRET=

# Google Maps (Maps JS via /api/v1/geo/map-config/ + Geocoding for address → lat/lng)
GOOGLE_MAPS_API_KEY=

# --- Eslatmalar (cron) ---
# python manage.py remind_bookings
# python manage.py expire_pending_bookings
# Railway Cron Jobs (har 10 daqiqa):
#   Schedule: */10 * * * *
#   Command:  python manage.py remind_bookings
#   Working directory: backend (yoki loyiha root + cd backend)
# Pending javobsiz bronlar (har 1–2 daqiqa):
#   Schedule: */2 * * * *
#   Command:  python manage.py expire_pending_bookings

# --- Media persistence (production) ---
# Default (DEBUG=false): yangi yuklamalar Postgres StoredMedia jadvaliga yoziladi —
# redeploy / ephemeral diskda rasmlar yo‘qolmaydi. User/barber/salon/admin ma’lumotlari
# allaqachon Postgresda; faqat media fayllar shu storage orqali DB ga bog‘lanadi.
# USE_DB_MEDIA=true          # majburan DB storage (localda ham)
# USE_LOCAL_MEDIA=true       # majburan lokal disk (tavsiya etilmaydi — deployda yo‘qoladi)
# Legacy disk fayllarni DB ga: python manage.py import_media_to_db
#
# Yoki S3 / Cloudflare R2:
# USE_S3_MEDIA=true
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=   (CDN domen, ixtiyoriy)

# --- To'lov (Click / Payme) — credentials bo'lmaguncha DEBUG stub ---
# CLICK_MERCHANT_ID=
# CLICK_SERVICE_ID=
# CLICK_SECRET_KEY=
# PAYME_MERCHANT_ID=
# PAYME_SECRET_KEY=

# --- Karta orqali to'ldirish (kompaniya kartasi, admin tasdiqlaydi) ---
# WALLET_RECEIVING_CARD_NUMBER=8600123456789012
# WALLET_RECEIVING_CARDHOLDER=MYSALOON LLC
# WALLET_RECEIVING_BANK=Uzcard / Humo
# WALLET_MERCHANT_REF=MYSALOON
# WALLET_DEPOSIT_ALERT_EMAIL=finance@mysaloon.uz
