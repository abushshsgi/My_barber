# Copy to .env. First run: python manage.py migrate
# Leave DATABASE_URL unset to use SQLite (backend/db.sqlite3).
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DJANGO_SECRET_KEY=change-me
# Lokalda admin CSS uchun odatda true qo'ying (yoki collectstatic + WHITENOISE_USE_FINDERS)
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app
# Uchta frontend (vigorul bilan, bo‘shliqsiz): mijoz, admin, sartarosh + lokal portlar
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,https://user.example.com,https://admin.example.com,https://barber.example.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# MVP: barber ro'yxatdan o'tganda admin tasdig'isiz darhol kirish (true tavsiya)
AUTO_APPROVE_BARBERS=true
