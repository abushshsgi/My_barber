# Copy to .env. First run: python manage.py migrate
# Admin panel (AdminAccount — alohida jadval): python manage.py create_admin_account you@example.com
# Leave DATABASE_URL unset to use SQLite (backend/db.sqlite3).
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DJANGO_SECRET_KEY=change-me
# Lokalda admin CSS uchun odatda true qo'ying (yoki collectstatic + WHITENOISE_USE_FINDERS)
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app

# --- CORS: uchta frontend (har biri alohida o'zgaruvchi) ---
# Brauzerdagi manzil bilan 1:1 mos kelishi kerak (masalan Vercel: https://xxx.vercel.app, oxirida / yo'q).
# Productionda ochib, o'z domenlaringizni yozing:
# FRONTEND_USER_ORIGIN=https://app.example.com
# FRONTEND_ADMIN_ORIGIN=https://admin.example.com
# FRONTEND_BARBER_ORIGIN=https://barber.example.com
# Lokal: uchta ham bo'sh qoldiring — pastdagi default (3000/3001/3002) ishlatiladi.
# Yoki aniq yozing:
# FRONTEND_USER_ORIGIN=http://localhost:3000
# FRONTEND_ADMIN_ORIGIN=http://localhost:3001
# FRONTEND_BARBER_ORIGIN=http://localhost:3002

# Ixtiyoriy: qo'shimcha manzillar (preview URL) — vergul bilan
# CORS_ALLOWED_ORIGINS=https://preview-xxx.vercel.app

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# MVP: barber ro'yxatdan o'tganda admin tasdig'isiz darhol kirish (true tavsiya)
AUTO_APPROVE_BARBERS=true
