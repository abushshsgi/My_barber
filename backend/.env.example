# =============================================================================
# MyBarber backend — nusxa:  cp .env.example .env
# =============================================================================
#   pip install -r requirements.txt
#   python manage.py migrate
#   python manage.py runserver
#
# Admin: python manage.py create_admin_account you@example.com
# =============================================================================

# --- Ma’lumotlar bazasi ---
# Comment / o‘chirish → SQLite: backend/db.sqlite3
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app
# Production (mysaloon.uz): ikkalasidan biri yetarli
# DJANGO_ALLOWED_HOSTS=api.mysaloon.uz,.railway.app
# API_PUBLIC_HOST=api.mysaloon.uz

# --- Hamyon ---
# Production'da alohida uzun random string (SECRET_KEY dan farqli bo'lsin).
# WALLET_HMAC_SECRET=

# --- WebSocket (Channels) + OTP cache ---
# Lokal: bo'sh — InMemory. Production: Redis (Channels + CACHES ikkalasi uchun)
REDIS_URL=

# --- Pixabay (salon fallback cover sync skripti — frontendda emas) ---
# https://pixabay.com/api/docs/
# PIXABAY_API_KEY=
# node scripts/sync-pixabay-covers.mjs

# --- Pexels (mock salon seed — backend) ---
# https://www.pexels.com/api/documentation/
# PEXELS_API_KEY=   (faqat --upload-images --pexels-api uchun)
# Tez deploy (tavsiya):
#   python manage.py seed_tashkent_mock_salons
# Rasmlar API orqali Pexels CDN qaytadi — fayl yuklash shart emas.
# Sekin (storage ga fayl):
#   python manage.py seed_tashkent_mock_salons --upload-images

# --- CORS / frontend (oxirida / yo‘q) ---
# FRONTEND_USER_ORIGIN=http://localhost:3000
# FRONTEND_ADMIN_ORIGIN=http://localhost:3001
# FRONTEND_BARBER_ORIGIN=http://localhost:5173
# Production (mysaloon.uz + Vercel):
# FRONTEND_USER_ORIGIN=https://www.mysaloon.uz,https://mysaloon.uz
# FRONTEND_ADMIN_ORIGIN=https://admin.mysaloon.uz
# FRONTEND_BARBER_ORIGIN=https://partner.mysaloon.uz
# (email tasdiq havolasi: https://partner.mysaloon.uz/verify-email?token=...)
# Barber email tasdiq havolasi — FRONTEND_BARBER_ORIGIN ning birinchi URL
# Mobil ilova deep link scheme (default: mysaloonpartner)
# BARBER_MOBILE_VERIFY_SCHEME=mysaloonpartner
# CORS_ALLOW_HEADERS (x-session-id) — backend/config/settings.py da default_headers bilan berilgan.
# CORS_ALLOWED_ORIGINS=https://preview-xxx.vercel.app
# Capacitor (Android Play Market) — settings.py default ro‘yxatga qo‘shiladi; qo‘shimcha origin kerak bo‘lsa:
# CORS_ALLOWED_ORIGINS=https://localhost,http://localhost,capacitor://localhost
#
# --- Production Railway checklist (mobil + PWA) ---
# Tayyor fayl: backend/.env.production (gitignore — Railway Variables ga nusxa)
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=api.mysaloon.uz,.railway.app
# API_PUBLIC_HOST=api.mysaloon.uz
# FRONTEND_USER_ORIGIN=https://www.mysaloon.uz,https://mysaloon.uz
# FRONTEND_ADMIN_ORIGIN=https://admin.mysaloon.uz
# FRONTEND_BARBER_ORIGIN=https://partner.mysaloon.uz
# REDIS_URL=redis://...   (WebSocket/chat uchun majburiy)
# VERTEX_SERVICE_ACCOUNT_JSON={"type":"service_account",...}  (bitta qator JSON)
# GOOGLE_APPLICATION_CREDENTIALS faqat lokal — Railway da ishlatilmaydi

# --- SMS OTP (mijoz login) ---
# Hozir bo‘sh — kod ilovada ko‘rinadi (delivery=app). Keyin provayder ulang:
# SMS_PROVIDER=eskiz
# ESKIZ_EMAIL=
# ESKIZ_PASSWORD=

# --- Email ---
# VARIANT A (Railway / bulut — tavsiya): Resend HTTPS (443); SMTP uchun TCP ko‘pincha timeout.
# Qo‘shyotganda SETTINGS avtomatik Resend EMAIL_BACKEND ga o‘tadi.
RESEND_API_KEY=
#
# VARIANT B — to‘g‘ridan-to‘g‘ri SMTP (aHost va h.k., odatda o‘zingizning VPS):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# aHost — Outgoing: de.ahost.cloud port 465 SSL
#
# --- Email SMTP (faqat VARIANT B; VARIANT A da ham DEFAULT_FROM_EMAIL / BARBER_FROM_EMAIL kerak) ---
# RESEND yo‘qligicha lokal uchun console mumkin:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# aHost cPanel — Outgoing (SMTP): de.ahost.cloud, port 465, SSL
EMAIL_HOST=de.ahost.cloud
EMAIL_PORT=465
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true
EMAIL_HOST_USER=verify@mysaloon.uz
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@mysaloon.uz
BARBER_FROM_EMAIL=MySaloon <verify@mysaloon.uz>

# --- AI Stil (MySaloon) ---
# Scan/tahlil: Vertex yoki GEMINI_API_KEY. Rasm: asosan GEMINI_API_KEY (AI Studio).
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Rasm generatsiya (try-on, explore-gen) — AI Studio API kaliti (asosiy)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
VERTEX_IMAGE_MODEL=gemini-3.1-flash-lite-image
# Vertex faqat zaxira (GEMINI_API_KEY bo'lmasa)

# Try-on Redis navbat (REDIS_URL bo'lsa avtomatik; worker bin/start.sh da ishga tushadi)
# TRYON_QUEUE_ENABLED=true
# TRYON_QUEUE_MAX_DEPTH=200
# TRYON_JOB_TTL_SECONDS=3600

# Ixtiyoriy: scan/tahlil uchun Vertex (yoki yuqoridagi GEMINI_API_KEY)
# VERTEX_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Service account: Vertex AI User + billing yoqilgan
VERTEX_IMAGE_LOCATION=global

# Explore rasm generatsiya (production: DEBUG=false + secret)
# GEMINI_API_KEY (AI Studio) — reference + uslub rasmlar.
# Sahifa: https://www.mysaloon.uz/dev/explore-gen?key=YOUR_SECRET
EXPLORE_GEN_SECRET=

# 2GIS Geocoder (server-side proxy for barber address → lat/lng)
DGIS_API_KEY=

# --- Eslatmalar (cron) ---
# python manage.py remind_bookings
# python manage.py expire_pending_bookings
# Railway Cron Jobs (har 10 daqiqa):
#   Schedule: */10 * * * *
#   Command:  python manage.py remind_bookings
#   Working directory: backend (yoki loyiha root + cd backend)
# Pending javobsiz bronlar (har 1–2 daqiqa):
#   Schedule: */2 * * * *
#   Command:  python manage.py expire_pending_bookings

# --- Media (ixtiyoriy — production S3) ---
# USE_S3_MEDIA=true
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=eu-central-1
# AWS_S3_CUSTOM_DOMAIN=   (CDN domen, ixtiyoriy)

# --- To'lov (Click / Payme) — credentials bo'lmaguncha DEBUG stub ---
# CLICK_MERCHANT_ID=
# CLICK_SERVICE_ID=
# CLICK_SECRET_KEY=
# PAYME_MERCHANT_ID=
# PAYME_SECRET_KEY=
