FRONTEND_USER_ORIGIN=https://demo.mysaloon.uz
FRONTEND_BARBER_ORIGIN=https://demo.partner.mysaloon.uz
FRONTEND_ADMIN_ORIGIN=https://admin.mysaloon.uz

