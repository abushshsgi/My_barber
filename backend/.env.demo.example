# Demo muhit — Railway: celebrated-acceptance-production.up.railway.app
# Production DB dan MUSTAQIL. Faqat seed_demo ma'lumotlari (30 salon, 10 barber).

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=<yangi-random-kalit>
DJANGO_ALLOWED_HOSTS=celebrated-acceptance-production.up.railway.app,.railway.app
API_PUBLIC_HOST=celebrated-acceptance-production.up.railway.app

DATABASE_URL=<alohida-postgres-url>

# Vercel demo frontendlar (CORS)
FRONTEND_USER_ORIGIN=https://demouser.vercel.app
FRONTEND_BARBER_ORIGIN=https://demo-partner-eight.vercel.app
FRONTEND_ADMIN_ORIGIN=https://admin.mysaloon.uz

# Kelajakda custom domen:
# FRONTEND_USER_ORIGIN=https://demouser.vercel.app,https://demo.mysaloon.uz
# FRONTEND_BARBER_ORIGIN=https://demo-partner-eight.vercel.app,https://demo.partner.mysaloon.uz

# 2GIS MapGL + Geocoder (xarita va manzil qidiruv)
# 2GIS Console: demouser.vercel.app, mysaloon.uz domenlarini qo'shing
DGIS_API_KEY=
# Migratsiya + seed:
#   python manage.py migrate
#   python manage.py seed_demo
