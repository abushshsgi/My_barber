# VPS production paths (mysaloon.service + start.sh embedded workers is the default).
# Enable only when TRYON embedded workers are off: MYSALOON_STANDALONE_TRYON_WORKER=1 on deploy-backend.sh
[Unit]
Description=Mysaloon Try-On worker (standalone)
After=network.target postgresql.service redis-server.service
Requires=redis-server.service
PartOf=mysaloon.service

[Service]
Type=simple
User=mysaloon
Group=mysaloon
WorkingDirectory=/var/www/mysaloon/source/backend
EnvironmentFile=/var/www/mysaloon/source/backend/.env
Environment=PATH=/var/www/mysaloon/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=TRYON_WORKER_CONCURRENCY=3
Environment=TRYON_PROVIDER_CONCURRENCY=4
Environment=TRYON_PROVIDER_CONCURRENCY_CAP=4
Environment=TRYON_QUEUE_MAX_DEPTH=20000
ExecStart=/var/www/mysaloon/venv/bin/python manage.py run_tryon_worker --poll-seconds 5 --concurrency 3
Restart=on-failure
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target