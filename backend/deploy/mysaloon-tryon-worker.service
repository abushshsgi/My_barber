[Unit]
Description=Mysaloon Try-On worker
After=network.target redis.service postgresql.service
Requires=redis.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/mysaloon/Mybarber/backend
EnvironmentFile=/opt/mysaloon/Mybarber/backend/.env
Environment=TRYON_WORKER_CONCURRENCY=3
Environment=TRYON_PROVIDER_CONCURRENCY=4
Environment=TRYON_PROVIDER_CONCURRENCY_CAP=4
Environment=TRYON_QUEUE_MAX_DEPTH=20000
ExecStart=/opt/mysaloon/Mybarber/backend/.venv/bin/python manage.py run_tryon_worker --poll-seconds 5 --concurrency 3
Restart=always
RestartSec=3
Nice=5

# 4 vCPU / 8 GB VPS: 2 ta shu unit (mysaloon-tryon-worker@1 va @2) yoki
# bin/start.sh orqali TRYON_WORKER_COUNT=2. Global slotlar Redis da ulashiladi.

[Install]
WantedBy=multi-user.target
