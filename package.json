{
  "name": "mybarber",
  "private": true,
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:user": "npm run dev -w user-web -- -p 3000",
    "dev:admin": "npm run dev -w admin-web",
    "dev:barber": "npm run dev -w tanstack_start_ts -- --port 3002",
    "build:user": "npm run build -w user-web",
    "build:admin": "npm run build -w admin-web",
    "build:barber": "npm run build -w tanstack_start_ts",
    "build:frontends": "npm run build:user && npm run build:admin && npm run build:barber"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
