[Unit]
Description=Mysaloon user web (Nitro)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/mysaloon/Mybarber/apps/user
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=API_UPSTREAM_URL=https://api.mysaloon.uz
ExecStart=/usr/bin/node dist/server/index.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
