# DEPRECATED — merged into deploy/vps/nginx/mysaloon-user.conf (gzip + public static Cache-Control).
# Keep proxy_cache at the edge only after proxy_cache_path is configured; private /media must stay uncached.

# Inside the TLS server { } for mysaloon.uz, before `location /`:

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_vary on;

    location /assets/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Same-origin media — public salon covers only; private paths get private Cache-Control from API.
    location /media/ {
        proxy_pass https://api.mysaloon.uz;
        proxy_ssl_server_name on;
        proxy_set_header Host api.mysaloon.uz;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_valid 200 7d;
        proxy_cache_bypass $http_cache_control;
        proxy_no_cache $cookie_auth;
        proxy_read_timeout 120s;
    }

    location /covers/pexels/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=604800, immutable";
    }
